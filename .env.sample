# 개발 컨테이너 실행 설정
# 사용법: cp .env.sample .env 후 값을 채운다. .env는 git에 커밋되지 않는다.
#
# 형식 주의: docker --env-file 형식이다.
#   - 값에 따옴표를 쓰지 않는다 (따옴표도 값에 포함된다).
#   - 공백이 있어도 그대로 쓴다. 예) GIT_USER_NAME=InGee Kim
#   - 쓰지 않는 항목은 값을 비워 두거나 주석 처리한다.

# ---- 작업 루트 (필수) ----
# 개발 컨테이너의 /home/dev/work 에 mount할 개발머신 디렉터리
# ~ 와 $HOME 은 bin/claude-dev 가 개발머신의 홈으로 바꾼다.
# WSL에서는 /mnt/c/... 가 아니라 WSL 파일시스템(예: ~/work)을 지정한다 (파일 I/O 성능).
WORK_ROOT=~/work

# ---- git 커밋 작성자 ----
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# ---- GitLab (glab) ----
# GitLab 호스트 이름. glab 기본 호스트와 git HTTPS 인증(id/pw 입력 후 메모리 캐시)에 쓰인다.
GITLAB_HOST=gitlab.example.com

# ---- Confluence / Jira (atlassian MCP) ----
# URL이 하나라도 있으면 개발 컨테이너 시작 시 atlassian MCP가 등록된다. 모두 비우면 등록하지 않는다.
# Server/Data Center는 PERSONAL_TOKEN을 쓴다.
CONFLUENCE_URL=
CONFLUENCE_PERSONAL_TOKEN=
JIRA_URL=
JIRA_PERSONAL_TOKEN=
