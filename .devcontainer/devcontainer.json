{
  "name": "claude-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "dev",
      "userUid": "1000",
      "userGid": "1000",
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false
    },
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/java:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/go:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "./features/claude-env": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/devcontainers/features/java",
    "ghcr.io/devcontainers/features/go",
    "ghcr.io/devcontainers/features/github-cli",
    "./features/claude-env"
  ],

  "containerUser": "dev",
  "remoteUser": "dev",

  // --rm: 중지하면 컨테이너를 지운다. 남겨야 할 상태는 아래 named volume에만 둔다.
  // --workdir: docker exec로 접속할 때 작업 루트에서 시작한다 (workspaceFolder는 docker exec에 적용되지 않는다).
  "runArgs": [
    "--rm",
    "--name", "claude-dev",
    "--hostname", "claude-dev",
    "--workdir", "/home/dev/work",
    "--env-file", "${localWorkspaceFolder}/.env"
  ],

  // 작업 루트: bin/claude-dev가 .env의 WORK_ROOT를 환경변수로 넘긴다.
  "workspaceMount": "source=${localEnv:WORK_ROOT},target=/home/dev/work,type=bind",
  "workspaceFolder": "/home/dev/work",

  "mounts": [
    // 공통 설정과 실행 스크립트: 빌드 레포를 읽기 전용으로 mount한다 (docs/adr/0002)
    "source=${localWorkspaceFolder}/common,target=/opt/claude-container/common,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/scripts,target=/opt/claude-container/bin,type=bind,readonly",
    // Claude Code가 잠그는 공통 키(hooks, statusLine, enabledPlugins): managed settings 디렉터리로 mount한다.
    // 파일이 아니라 디렉터리를 mount해야 편집기가 파일을 새로 써도 반영된다.
    "source=${localWorkspaceFolder}/common/claude-managed,target=/etc/claude-code,type=bind,readonly",
    // 컨테이너 상태: 개발머신의 디렉터리와 무관한 Docker named volume
    "source=claude-dev-claude,target=/home/dev/.claude,type=volume",
    "source=claude-dev-gh,target=/home/dev/.config/gh,type=volume",
    "source=claude-dev-glab,target=/home/dev/.config/glab-cli,type=volume",
    // nvim 플러그인, LSP 서버, treesitter 파서 (docs/adr/0003)
    "source=claude-dev-nvim,target=/home/dev/.local/share/nvim,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "EDITOR": "nvim",
    "VISUAL": "nvim"
  },

  // 공통 설정 덮어쓰기, MCP 등록, git 설정 (docs/adr/0002 참고)
  "postStartCommand": "/opt/claude-container/bin/post-start.sh"
}
